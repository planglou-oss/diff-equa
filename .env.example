# Copy this file to .env in the project root to enable AI chat.
# These variables are read by Go only. Do not prefix them with VITE_.
GEMINI_API_KEY=
# Set a Gemini model supported by your account, for example gemini-3.8-flash.
GEMINI_MODEL=
# Gemini 3 defaults to low in this app. Use default to leave provider settings unchanged.
GEMINI_THINKING_LEVEL=low
